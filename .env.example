# Copy this file to .env and fill it in.

# From https://app.simli.com (API key in your profile).
SIMLI_API_KEY=

# From https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Optional: any Trinity-2 face ID and OpenAI Realtime voice. Defaults are in bot.py: Simli's
# default Trinity-2 face (14c60d62-6ebf-424d-b626-1f4f91c33b04, a woman) and the female voice marin.
SIMLI_FACE_ID=
OPENAI_VOICE=

# Which web pages may talk to the bot from a browser. Without it Pipecat's runner allows every
# origin, so any website you visit could start sessions on your keys. Add your page's origin if
# it isn't one of these.
PIPECAT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:7860
