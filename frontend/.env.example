# Optional: copy this file to .env.local. The page holds no API keys.

# Where the bot runs. Defaults to http://localhost:7860. Read when each request arrives, so you
# can change it without rebuilding.
BOT_URL=

# Production builds (`npm run build` + `npm start`, or a deployed host) refuse to pass offers to
# the bot, because /api/offer has no login and every offer starts a billed session. Add your own
# auth to app/api/offer/route.ts. For a demo or internal network only, set this to true to let
# anyone who can reach the page start sessions.
ALLOW_UNAUTHENTICATED_SESSIONS=
